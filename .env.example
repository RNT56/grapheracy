# Local development only. Copy to .env and never commit real secrets.
GRAPHVIEW_ENV=local
GRAPHVIEW_PUBLIC_BASE_URL=http://localhost:5173
GRAPHVIEW_API_BASE_URL=http://localhost:8000
GRAPHVIEW_DATABASE_URL=sqlite:///./.graphview/graphview.sqlite
GRAPHVIEW_SECRET_KEY=local-dev-graphview-secret
GRAPHVIEW_LOCAL_SECRET_STORE_PATH=./.graphview/secrets
GRAPHVIEW_LLM_ENABLED=false
GRAPHVIEW_LLM_PROVIDER=openai-compatible
GRAPHVIEW_LLM_BASE_URL=https://api.openai.com/v1
GRAPHVIEW_LLM_MODEL=gpt-4.1-mini
GRAPHVIEW_LLM_API_KEY=
GRAPHVIEW_AUTO_COMMIT_THRESHOLD=0.92
GRAPHVIEW_SAFE_ACTION_TYPES=mark_source_stale,mark_source_refreshed,create_notification,create_external_ticket,trigger_workflow,connector_sync,create_graph_proposal,request_owner_confirmation
GRAPHVIEW_ACTION_WEBHOOK_ALLOWED_HOSTS=
GRAPHVIEW_SMTP_HOST=
GRAPHVIEW_SMTP_PORT=587
GRAPHVIEW_SMTP_STARTTLS=true
GRAPHVIEW_SMTP_FROM_ADDRESS=
GRAPHVIEW_SMTP_SUPPRESSED_RECIPIENTS=
GRAPHVIEW_AI_DEFAULT_PROVIDER=graphview-local
GRAPHVIEW_OPENAI_BASE_URL=https://api.openai.com/v1
GRAPHVIEW_OPENAI_MODEL=gpt-5.5
GRAPHVIEW_OPENAI_API_KEY=
GRAPHVIEW_ANTHROPIC_BASE_URL=https://api.anthropic.com
GRAPHVIEW_ANTHROPIC_MODEL=claude-opus-4.8
GRAPHVIEW_ANTHROPIC_API_KEY=
GRAPHVIEW_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GRAPHVIEW_GEMINI_MODEL=gemini-3.1-pro
GRAPHVIEW_GEMINI_API_KEY=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphview
POSTGRES_USER=graphview
POSTGRES_PASSWORD=graphview-local-only

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=graphview-local
MINIO_ACCESS_KEY=graphview
MINIO_SECRET_KEY=graphview-local-only

OIDC_ISSUER_URL=http://localhost:8000/dev-auth
OIDC_CLIENT_ID=graphview-local
OIDC_CLIENT_SECRET=local-only

ARQ_REDIS_URL=redis://localhost:6379/0
