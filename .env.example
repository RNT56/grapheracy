# Local development only. Copy to .env and never commit real secrets.
GRAPHVIEW_ENV=local
GRAPHVIEW_PUBLIC_BASE_URL=http://localhost:5173
GRAPHVIEW_API_BASE_URL=http://localhost:8000
GRAPHVIEW_DATABASE_URL=sqlite:///./.graphview/graphview.sqlite

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphview
POSTGRES_USER=graphview
POSTGRES_PASSWORD=graphview-local-only

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=graphview-local
MINIO_ACCESS_KEY=graphview
MINIO_SECRET_KEY=graphview-local-only

OIDC_ISSUER_URL=http://localhost:8000/dev-auth
OIDC_CLIENT_ID=graphview-local
OIDC_CLIENT_SECRET=local-only

ARQ_REDIS_URL=redis://localhost:6379/0
